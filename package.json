{
  "name": "c-rotulus",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/minify-assets.mjs && next dev -p 12000",
    "build": "node scripts/minify-assets.mjs && prisma generate && next build",
    "minify": "node scripts/minify-assets.mjs",
    "images": "node tools/optimize-images.mjs",
    "start": "next start -p 12000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:status": "node scripts/prisma.mjs migrate status",
    "db:seed": "tsx scripts/seed.ts",
    "db:migrate-images": "tsx scripts/migrate-images.ts",
    "db:migrate-sqlite": "tsx scripts/migrate-sqlite-to-pg.ts",
    "user:password": "tsx scripts/set-password.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "next": "^15.5.4",
    "nodemailer": "^6.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
