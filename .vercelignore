# ============================================================================
#  .vercelignore  -  Que NO se sube a Vercel (C-ROTULUS: Next.js + Postgres)
# ----------------------------------------------------------------------------
#  El despliegue es NATIVO de Next.js: Vercel construye la app y ejecuta las
#  rutas de /api y /admin como funciones serverless (una sola funcion agrupada
#  por ruta, muy por debajo del limite de 12 del plan Hobby). La base de datos
#  es PostgreSQL externa (Neon), por lo que no se sube ningun dato.
# ============================================================================

# --- Secretos y datos locales (NUNCA subir) --------------------------------
.env
.env.*
!.env.example
app-data/
*.log
*.sqlite
*.sqlite-*

# --- Backend PHP antiguo (se conserva en el repo como referencia) ----------
legacy/

# --- Herramientas y artefactos de desarrollo -------------------------------
tools/
preview/
.agent_tmp/
c-rotulus-sitio.zip

# --- Documentacion interna (no hace falta publicarla) ----------------------
AGENTS.md
DEPLOY.md
DEPLOY-RAIOLA.md
VERCEL.md

# --- Metadatos de repositorio ----------------------------------------------
.git/
.gitignore
