# ============================================================================
#  .vercelignore  —  Qué NO se sube a Vercel
# ----------------------------------------------------------------------------
#  En Vercel publicamos SOLO la web estática (HTML/CSS/JS/imágenes). El backend
#  PHP (api/, admin/, app/) se sirve desde tu hosting con PHP (Raiola): ver
#  VERCEL.md, sección 0 y Opción B.
#
#  ¿Por qué? El plan Hobby de Vercel limita a 12 funciones serverless por
#  despliegue y tu panel tiene 21 archivos .php -> el build falla. Además su
#  firewall bloquea /admin. Por eso el panel vive en Raiola.
# ============================================================================

# --- Backend PHP: NO se sube a Vercel (se sirve en Raiola) ------------------
api/
admin/
app/

# --- NUNCA subir credenciales ni datos locales -----------------------------
config.local.php
app/data/*.sqlite
app/data/*.sqlite-*
app/data/*.log

# --- Herramientas y artefactos de desarrollo -------------------------------
tools/
preview/
.agent_tmp/
c-rotulus-sitio.zip
deploy/

# --- Documentacion interna (no hace falta publicarla) ----------------------
AGENTS.md
DEPLOY.md
DEPLOY-RAIOLA.md
VERCEL.md

# --- Metadatos de repositorio ----------------------------------------------
.git/
.gitignore
.htaccess
