# ============================================================================
#  .vercelignore  —  Qué NO se sube a Vercel
# ----------------------------------------------------------------------------
#  Vercel es un hosting estatico + funciones serverless (Node, Python, Go,
#  Ruby). NO ejecuta PHP y NO tiene disco persistente. Por eso excluimos todo
#  el backend PHP, los datos y los archivos de desarrollo: en Vercel solo
#  tiene sentido publicar la parte estatica del sitio web.
# ============================================================================

# --- Backend PHP (no se ejecuta en Vercel) ---------------------------------
api/
admin/
app/
deploy/

# --- Configuracion y datos sensibles / generados ---------------------------
app/config.local.php
*.sqlite
*.log

# --- Herramientas y artefactos de desarrollo -------------------------------
tools/
preview/
.agent_tmp/
c-rotulus-sitio.zip
*.sh

# --- Documentacion interna (no hace falta publicarla) ----------------------
AGENTS.md
DEPLOY.md
DEPLOY-RAIOLA.md
VERCEL.md

# --- Metadatos de repositorio ----------------------------------------------
.git/
.gitignore
.htaccess
