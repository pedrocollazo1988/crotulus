# ============================================================================
#  .vercelignore  —  Qué NO se sube a Vercel
# ----------------------------------------------------------------------------
#  Dejamos FUERA solo lo que no debe publicarse: datos con credenciales, la
#  base de datos local, las herramientas y la documentacion interna.
#  El backend PHP (api/, admin/, app/) SI se sube: lo ejecuta el runtime
#  vercel-php declarado en vercel.json (ver VERCEL.md).
# ============================================================================

# --- NUNCA subir credenciales ni datos locales -----------------------------
app/config.local.php
app/data/*.sqlite
app/data/*.sqlite-*
app/data/*.log

# --- Herramientas y artefactos de desarrollo -------------------------------
tools/
preview/
.agent_tmp/
c-rotulus-sitio.zip
deploy/

# --- Documentacion interna (no hace falta publicarla) ----------------------
AGENTS.md
DEPLOY.md
DEPLOY-RAIOLA.md
VERCEL.md

# --- Metadatos de repositorio ----------------------------------------------
.git/
.gitignore
.htaccess
