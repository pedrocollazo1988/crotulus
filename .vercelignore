# ============================================================================
#  .vercelignore  —  Qué NO se sube a Vercel (opción B: contenedor)
# ----------------------------------------------------------------------------
#  Con el contenedor (Dockerfile.vercel + Caddyfile) SÍ subimos el backend PHP
#  completo (api/, admin/, app/): lo ejecuta FrankenPHP dentro de la imagen.
#  Solo excluimos datos sensibles, herramientas y documentación interna.
# ============================================================================

# --- NUNCA subir credenciales ni datos locales -----------------------------
config.local.php
app/config.local.php
app/data/*.sqlite
app/data/*.sqlite-*
app/data/*.log

# --- Herramientas y artefactos de desarrollo -------------------------------
tools/
preview/
.agent_tmp/
c-rotulus-sitio.zip
deploy/

# --- Documentacion interna (no hace falta publicarla) ----------------------
AGENTS.md
DEPLOY.md
DEPLOY-RAIOLA.md
VERCEL.md

# --- Metadatos de repositorio ----------------------------------------------
.git/
.gitignore
