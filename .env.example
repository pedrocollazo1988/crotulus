# ============================================================================
#  Variables de entorno de C-ROTULUS (Next.js + PostgreSQL)
#  Copia este archivo como .env.local y rellena los valores reales.
#  En Vercel se configuran en Settings > Environment Variables.
# ============================================================================

# --- Base de datos (Neon PostgreSQL) ----------------------------------------
# Con la integracion Neon del Marketplace de Vercel estas dos variables se
# inyectan solas en el proyecto (no hay que copiarlas a mano):
#   DATABASE_URL           -> host POOLER (serverless abre muchas conexiones)
#   DATABASE_URL_UNPOOLED  -> conexion directa (la usan las migraciones)
# El esquema de Prisma usa DIRECT_URL para las migraciones; si no existe, el
# envoltorio scripts/prisma.mjs la rellena desde DATABASE_URL_UNPOOLED (o
# DATABASE_URL). Por eso en Vercel no hace falta definir DIRECT_URL.
DATABASE_URL="postgresql://usuario:contrasena@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:contrasena@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Sitio ------------------------------------------------------------------
APP_SITE_URL="https://www.c-rotulus.com"
APP_KEY="cambia-esta-clave-por-una-larga-y-aleatoria-000"
TZ="Europe/Madrid"

# --- Administrador (recomendado en despliegues serverless) ------------------
# El build crea/promueve el administrador. Si ADMIN_EMAIL esta vacio, se usa el
# correo que ya recibe los avisos del sitio (MAIL_TO o el ajuste
# "mail_to_email"), asi que normalmente no hace falta configurar nada.
# De paso, degrada a "user" cualquier admin que nunca verifico su correo.
#
# Contrasena:
#  - ADMIN_PASSWORD: se aplica al CREAR la cuenta (o si aun no tiene contrasena).
#    Si la dejas vacia, el build genera una temporal y la imprime en el registro.
#  - ADMIN_RESET_PASSWORD: para fijar/cambiar la contrasena de una cuenta que ya
#    existe (se aplica una vez, y no se repite en los siguientes builds).
#  - Si defines ADMIN_PASSWORD pero NO ADMIN_RESET_PASSWORD, un despliegue NO
#    pisa la contrasena que hayas cambiado luego en el panel.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD=""
ADMIN_NAME="Administrador"

# --- Correo (SMTP) ----------------------------------------------------------
MAIL_TRANSPORT="smtp"
MAIL_SMTP_HOST="smtp.gmail.com"
MAIL_SMTP_PORT="587"
MAIL_SMTP_USER="crotulus.mipyme@gmail.com"
MAIL_SMTP_PASS=""
MAIL_SMTP_SECURE="tls"
MAIL_FROM_NAME="C-ROTULUS"
MAIL_TO="crotulus.mipyme@gmail.com"

# --- Google OAuth / Places --------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PLACES_API_KEY=""

# --- Verificacion en dos pasos (2FA) ----------------------------------------
# Estas claves tambien se pueden editar desde el panel (Ajustes > Seguridad),
# que tiene prioridad sobre estos valores por defecto.
#   TWO_FACTOR_MODE: optional | required | disabled
#     required (por defecto) = se pide a todas las cuentas, incluidas sin 2FA
#     propio. El codigo se envia por correo (o SMS si esta configurado).
#     disabled = interruptor de EMERGENCIA: se salta el 2FA aunque el panel lo
#     tenga en "required". Ponlo asi (y redepliega) solo si el envio de codigos
#     falla (p. ej. SMTP sin contrasena) y no puedes entrar al panel.
TWO_FACTOR_MODE="required"
TWO_FACTOR_CHANNEL_DEFAULT="email"
TWO_FACTOR_CODE_TTL="600"            # caducidad del codigo, en segundos
TWO_FACTOR_MAX_ATTEMPTS="5"          # intentos por codigo antes de invalidarlo
TWO_FACTOR_RESEND_COOLDOWN="60"      # espera entre reenvios, en segundos
TWO_FACTOR_TRUST_DEVICE_DAYS="30"    # dias de "recordar este dispositivo"
TWO_FACTOR_REMEMBER_DEVICE="1"       # 1 = permitir recordar el dispositivo

# --- SMS (Twilio) -----------------------------------------------------------
# Proveedor de SMS para los codigos 2FA. Sin esto, la 2FA usa solo el correo.
SMS_PROVIDER="disabled"              # disabled | twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                       # numero emisor, p. ej. +12025550123
SMS_DEFAULT_COUNTRY_CODE="+53"       # prefijo que se antepone a los numeros locales
