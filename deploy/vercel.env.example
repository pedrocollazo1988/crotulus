# ============================================================================
#  deploy/vercel.env.example  -  Valores para "tools/setup-vercel-env.sh"
# ----------------------------------------------------------------------------
#  1. Copia este archivo a  deploy/vercel.env   (esta ignorado por git).
#  2. Rellena los valores.
#  3. Ejecuta:  bash tools/setup-vercel-env.sh
#
#  DATABASE_URL y DATABASE_URL_UNPOOLED NO se ponen aqui: las inyecta sola la
#  integracion de Neon del Marketplace de Vercel. Si usas Neon por tu cuenta,
#  descomenta las dos lineas del final.
#
#  Deja en blanco lo que no uses: el script omite las variables vacias.
# ============================================================================

# --- Sitio (obligatorio) -----------------------------------------------------
# Dominio de produccion. Sin barra final.
APP_SITE_URL="https://c-rotulus.com"

# URL del despliegue de preview (opcional). Si la dejas vacia, se usa APP_SITE_URL.
# Suele ser el alias de la rama, p. ej. https://crotulus-git-dev-plca-<usuario>.vercel.app
APP_SITE_URL_PREVIEW=""

# APP_KEY: firma CSRF, captcha y sesiones. Si la dejas vacia, el script genera
# una aleatoria y la escribe aqui. Cambiarla invalida las sesiones abiertas.
APP_KEY=""

# Zona horaria (Cuba).
TZ="America/Havana"

# --- Administrador (recomendado) ---------------------------------------------
# El build crea/promueve esta cuenta como administrador activo y degrada los
# admin que nunca verificaron su correo. Si ADMIN_EMAIL queda vacio, se usa el
# correo que recibe los avisos del sitio (MAIL_TO).
# ADMIN_PASSWORD se aplica al CREAR la cuenta (si falta, se genera una temporal).
# Para fijar/cambiar la contrasena de una cuenta existente usa
# ADMIN_RESET_PASSWORD (se aplica una vez y no se repite en los siguientes builds).
# ADMIN_DISABLE_2FA=1 apaga la verificacion en dos pasos del administrador (util
# si el correo de codigos no funciona; quita la variable para reactivarla).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD=""
ADMIN_DISABLE_2FA=""
ADMIN_NAME="C-ROTULUS"

# --- Correo (recomendado) ----------------------------------------------------
# Contrasena de APLICACION de Gmail (16 caracteres, sin espacios), no la normal.
MAIL_SMTP_USER="crotulus.mipyme@gmail.com"
MAIL_SMTP_PASS=""
MAIL_TO="crotulus.mipyme@gmail.com"

# --- Google (opcional) -------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_PLACES_API_KEY=""

# --- Verificacion en dos pasos (2FA) -----------------------------------------
# Por defecto el 2FA es OPCIONAL: cada usuario lo activa en "Mi cuenta". En
# Ajustes > Seguridad puede ponerse "Obligatoria para todos".
# Interruptor de EMERGENCIA: si el correo falla y no puedes entrar al panel,
# pon "disabled" y redepliega; retiralo luego.
#   TWO_FACTOR_MODE="disabled"

# --- Neon manual (solo si NO usas la integracion del Marketplace) ------------
# DATABASE_URL=""
# DATABASE_URL_UNPOOLED=""
