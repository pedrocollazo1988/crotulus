// ============================================================================
//  C-ROTULUS · Esquema PostgreSQL (Prisma)
// ----------------------------------------------------------------------------
//  Migracion 1:1 de las tablas del backend PHP (app/schema.sql + app/lib/db.php).
//  Mejoras que aprovecha Postgres:
//    - meta TEXT (json_encode)  -> Json  (JSONB)
//    - is_active INT (0/1)      -> Boolean
//    - php_sessions             -> se elimina (no aplica en Next)
//    - rate_limits              -> upsert atomico con ON CONFLICT
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String    @default("")
  passwordHash    String?   @map("password_hash")
  role            String    @default("user")
  status          String    @default("pending")
  emailVerifiedAt DateTime? @map("email_verified_at")
  googleId        String?   @unique @map("google_id")
  avatarUrl       String?   @map("avatar_url")
  lastLoginAt     DateTime? @map("last_login_at")

  // Verificacion en dos pasos (2FA)
  twoFactorEnabled  Boolean   @default(false) @map("two_factor_enabled")
  twoFactorChannel  String    @default("email") @map("two_factor_channel")
  twoFactorPhone    String?   @default("") @map("two_factor_phone")
  twoFactorRequired Boolean   @default(false) @map("two_factor_required")
  twoFactorPending  Boolean   @default(false) @map("two_factor_pending")

  createdAt       DateTime? @map("created_at")
  updatedAt       DateTime? @map("updated_at")

  sessions    Session[]
  tokens      Token[]
  submissions UserSubmission[]
  otpCodes    OtpCode[]
  devices     TrustedDevice[]

  @@map("users")
}

model OtpCode {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  purpose      String    @default("login")
  codeHash     String    @map("code_hash")
  challengeHash String   @map("challenge_hash")
  channel      String    @default("email")
  destination  String    @default("")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5) @map("max_attempts")
  usedAt       DateTime? @map("used_at")
  expiresAt    DateTime? @map("expires_at")
  ip           String?   @default("")
  createdAt    DateTime? @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([challengeHash])
  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model TrustedDevice {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  label     String?   @default("")
  ip        String?   @default("")
  userAgent String?   @default("") @map("user_agent")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime? @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("trusted_devices")
}

model Session {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash")
  ip        String?   @default("")
  userAgent String?   @default("") @map("user_agent")
  createdAt DateTime? @map("created_at")
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("sessions")
}

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  tokenHash String    @map("token_hash")
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime? @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("tokens")
}

model ContactMessage {
  id        Int       @id @default(autoincrement())
  userId    Int       @default(0) @map("user_id")
  name      String
  email     String
  phone     String?   @default("")
  service   String?   @default("")
  message   String
  status    String    @default("nuevo")
  ip        String?   @default("")
  userAgent String?   @default("") @map("user_agent")
  createdAt DateTime? @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

model RateLimit {
  id          Int    @id @default(autoincrement())
  bucket      String
  ip          String
  hits        Int    @default(1)
  windowStart Int    @map("window_start")

  @@unique([bucket, ip])
  @@map("rate_limits")
}

model Setting {
  skey      String    @id
  svalue    String?
  updatedAt DateTime? @map("updated_at")

  @@map("settings")
}

model ContentItem {
  id        Int       @id @default(autoincrement())
  ctype     String
  title     String?   @default("")
  subtitle  String?   @default("")
  body      String?
  meta      Json?
  sortOrder Int       @default(0) @map("sort_order")
  score     Int       @default(0)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@index([ctype])
  @@map("content_items")
}

model UserSubmission {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  stype      String
  title      String?   @default("")
  body       String?
  authorRole String?   @default("") @map("author_role")
  rating     Int       @default(5)
  status     String    @default("pendiente")
  score      Int       @default(0)
  ip         String?   @default("")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stype, status])
  @@map("user_submissions")
}

model Review {
  id          Int       @id @default(autoincrement())
  targetType  String    @map("target_type")
  targetId    Int       @default(0) @map("target_id")
  targetLabel String?   @default("") @map("target_label")
  rating      Int       @default(5)
  authorName  String    @map("author_name")
  authorEmail String?   @default("") @map("author_email")
  comment     String?
  userId      Int       @default(0) @map("user_id")
  status      String    @default("pendiente")
  ip          String?   @default("")
  userAgent   String?   @default("") @map("user_agent")
  createdAt   DateTime? @map("created_at")

  @@index([status])
  @@index([targetType, targetId])
  @@map("reviews")
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  slug        String    @default("")
  title       String?   @default("")
  excerpt     String?
  body        String?
  category    String?   @default("")
  author      String?   @default("")
  image       String?   @default("")
  meta        Json?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime? @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  @@index([isActive, publishedAt])
  @@map("blog_posts")
}

model TeamMember {
  id        Int       @id @default(autoincrement())
  name      String?   @default("")
  role      String?   @default("")
  bio       String?
  email     String?   @default("")
  phone     String?   @default("")
  avatar    String?   @default("")
  meta      Json?
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("team_members")
}

model GoogleReview {
  id           Int       @id @default(autoincrement())
  reviewKey    String    @unique @map("review_key")
  author       String?   @default("")
  rating       Int       @default(5)
  body         String?
  photo        String?   @default("")
  profileUrl   String?   @default("") @map("profile_url")
  relativeTime String?   @default("") @map("relative_time")
  sortTs       Int       @default(0) @map("sort_ts")
  fetchedAt    DateTime? @map("fetched_at")

  @@map("google_reviews")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  data      String?  @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_log")
}
