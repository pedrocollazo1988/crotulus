# ============================================================================
#  C-ROTULUS · Configuración de Apache (hosting compartido)
#  Sube todo el contenido de este proyecto a public_html.
# ============================================================================

# --- Página de inicio ---
DirectoryIndex index.html

# --- Sin listado de carpetas (evita ver archivos sueltos) ---
Options -Indexes

# --- Página de error propia (404.html en la raíz) ---
ErrorDocument 404 /404.html

# --- URLs "limpias" (sin .php) ----------------------------------------------
# La web enlaza a /admin/login, /api/contact... (necesario en Vercel, donde
# el firewall bloquea URLs .php). Aquí se traducen al archivo real.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # No reescribir ficheros ni carpetas que existen de verdad.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([A-Za-z0-9_/-]+)/?$ $1.php [L,QSA]
</IfModule>

# --- Compresión para una carga más rápida ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/json application/javascript application/ld+json image/svg+xml
</IfModule>

# --- Caché del navegador ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- Tipos MIME modernos (AVIF y fuentes) ---
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>

# --- Cabeceras de seguridad ---
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Descomenta cuando tengas HTTPS activo:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# --- Proteje archivos sensibles ---
<FilesMatch "(^\.|\.(sqlite|sqlite-journal|sqlite-wal|log|md)$|^config\.local\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# --- Bloquea el acceso directo a las carpetas de backend y herramientas ---
RedirectMatch 404 ^/app(/|$)
RedirectMatch 404 ^/deploy(/|$)
RedirectMatch 404 ^/tools(/|$)

# --- HTTPS obligatorio y dominio con/sin www (descomenta al activar el SSL) ---
# Elige UNA de las dos redirecciones y descomenta tambien el bloque de abajo.
#
# (a) Forzar HTTPS manteniendo el dominio tal cual:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>
#
# (b) Forzar HTTPS + www (recomendado para el dominio principal):
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on [OR]
#   RewriteCond %{HTTP_HOST} !^www\. [NC]
#   RewriteRule ^(.*)$ https://www.TU-DOMINIO.com/$1 [R=301,L]
# </IfModule>

# --- Forzar HTTPS detras de un proxy/CDN (Cloudflare, etc.) ----------------
# Descomenta si el sitio va detras de Cloudflare y ves redirecciones en bucle:
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP:X-Forwarded-Proto} =http
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>
